{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candoitall.local/schemas/codeanalytics/architecture-snapshot-v1.schema.json",
  "title": "ArchitectureSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "snapshotId",
    "createdUtc",
    "request",
    "facts",
    "insights",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatorVersion": {
      "type": "string"
    },
    "snapshotId": {
      "type": "string"
    },
    "createdUtc": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "$ref": "#/$defs/analysisRequest"
    },
    "facts": {
      "$ref": "#/$defs/factsRoot"
    },
    "insights": {
      "$ref": "#/$defs/insightsRoot"
    },
    "exports": {
      "$ref": "#/$defs/exportsRoot"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "analysisRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solutionPath",
        "includeDi",
        "includePersistence",
        "includeRisks"
      ],
      "properties": {
        "solutionPath": {
          "type": "string"
        },
        "scopeProjectNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scopeNamespacePrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeDi": {
          "type": "boolean"
        },
        "includePersistence": {
          "type": "boolean"
        },
        "includeRisks": {
          "type": "boolean"
        },
        "includeXmlDocs": {
          "type": "boolean"
        },
        "includeMermaidExports": {
          "type": "boolean"
        }
      }
    },
    "factsRoot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "solution": {
          "$ref": "#/$defs/solutionFact"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectFact"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/moduleFact"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeFact"
          }
        },
        "serviceRegistrations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceRegistrationFact"
          }
        },
        "dbContexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dbContextFact"
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityFact"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyEdgeFact"
          }
        }
      },
      "required": [
        "solution",
        "projects",
        "modules",
        "types",
        "serviceRegistrations",
        "dbContexts",
        "entities",
        "dependencies"
      ]
    },
    "insightsRoot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/summaryInsight"
        },
        "cycles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cycleInsight"
          }
        },
        "hotspots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspotInsight"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/findingInsight"
          }
        }
      },
      "required": [
        "summary",
        "cycles",
        "hotspots",
        "findings"
      ]
    },
    "exportsRoot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markdownSummaryPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "mermaidProjectGraphPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "mermaidClassDiagramPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "mermaidErDiagramPath": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "solutionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "projectCount"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "projectCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projectFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "name",
        "path",
        "targetFrameworks"
      ],
      "properties": {
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "targetFrameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packageReferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "moduleFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "projectId",
        "name"
      ],
      "properties": {
        "moduleId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespacePrefix": {
          "type": "string"
        }
      }
    },
    "typeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typeId",
        "projectId",
        "moduleId",
        "displayName",
        "kind",
        "source"
      ],
      "properties": {
        "typeId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "moduleId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Class",
            "Interface",
            "Record",
            "Struct",
            "Enum",
            "Delegate"
          ]
        },
        "baseTypeDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "interfaceDisplayNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "xmlSummary": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "serviceRegistrationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceRegistrationId",
        "source",
        "lifetime",
        "serviceTypeDisplayName"
      ],
      "properties": {
        "serviceRegistrationId": {
          "type": "string"
        },
        "lifetime": {
          "type": "string",
          "enum": [
            "Singleton",
            "Scoped",
            "Transient",
            "Unknown"
          ]
        },
        "serviceTypeDisplayName": {
          "type": "string"
        },
        "implementationTypeDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "registrationMethod": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "dbContextFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dbContextId",
        "typeId",
        "displayName"
      ],
      "properties": {
        "dbContextId": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "entityTypeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entityFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId",
        "typeId",
        "displayName"
      ],
      "properties": {
        "entityId": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "tableName": {
          "type": [
            "string",
            "null"
          ]
        },
        "relationshipTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dependencyEdgeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "kind",
        "fromId",
        "toId"
      ],
      "properties": {
        "edgeId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ProjectReference",
            "NamespaceDependency",
            "TypeDependency",
            "ServiceDependency"
          ]
        },
        "fromId": {
          "type": "string"
        },
        "toId": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "summaryInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectCount",
        "typeCount",
        "serviceRegistrationCount",
        "entityCount",
        "findingCount"
      ],
      "properties": {
        "projectCount": {
          "type": "integer",
          "minimum": 0
        },
        "typeCount": {
          "type": "integer",
          "minimum": 0
        },
        "serviceRegistrationCount": {
          "type": "integer",
          "minimum": 0
        },
        "entityCount": {
          "type": "integer",
          "minimum": 0
        },
        "findingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cycleInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "nodeIds"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "Project",
            "Module",
            "Type"
          ]
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        }
      }
    },
    "hotspotInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "kind",
        "score",
        "reason"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "findingInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "ruleId",
        "severity",
        "title",
        "description"
      ],
      "properties": {
        "findingId": {
          "type": "string"
        },
        "ruleId": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Info",
            "Warning",
            "Error"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "relatedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Info",
            "Warning",
            "Error"
          ]
        },
        "message": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/sourceReference"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
