        {
          "Title": "MBus.Drivers.BcdDateTimeParser.Parse(byte[])",
          "Kind": "Method",
          "StartLine": 8,
          "EndLine": 21,
          "Code": "    {\r\n        public DateTime Parse(byte[] data)\r\n        {\r\n            if (data.Length \u003C 4)\r\n                throw new ArgumentException(\u0022Data must have at least 4 bytes\u0022);\r\n\r\n            int hour = ParseBcdByte(data[0]);   // 0x33 = 33\r\n            int day = ParseBcdByte(data[1]);    // 0x04 = 4\r\n            int month = ParseBcdByte(data[2]);  // \u26A0\uFE0F 0x3A \u2192 invalid\r\n            int year = 2000 \u002B ParseBcdByte(data[3]);  // 0x31 = 31 \u2192 2031\r\n\r\n            return new DateTime(year, month, day, hour, 0, 0);\r\n        }\r\n        private int ParseBcdByte(byte b)"
        },
        {
          "Title": "MBus.Drivers.BcdDateTimeParser.ParseBcdByte(byte)",
          "Kind": "Method",
          "StartLine": 20,
          "EndLine": 31,
          "Code": "        }\r\n        private int ParseBcdByte(byte b)\r\n        {\r\n            int high = (b \u003E\u003E 4);\r\n            int low = b \u0026 0x0F;\r\n\r\n            if (high \u003E 9 || low \u003E 9)\r\n                throw new FormatException($\u0022Invalid BCD value: 0x{b:X2}\u0022);\r\n\r\n            return high * 10 \u002B low;\r\n        }\r\n    }"
        }
      ]
    }
  ]
