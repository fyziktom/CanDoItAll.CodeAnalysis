        {
          "Title": "MBus.Extensions.Decryption.AesCtrCrypto.BouncyCastleCrypto(bool, byte[], byte[], byte[])",
          "Kind": "Method",
          "StartLine": 35,
          "EndLine": 44,
          "Code": "\r\n        private byte[] BouncyCastleCrypto( bool forEncrypt, byte[] input, byte[] key, byte[] iv )\r\n        {\r\n            mode.Init( forEncrypt, new ParametersWithIV( new KeyParameter( key ), iv ) );\r\n\r\n            BufferedBlockCipher cipher = new BufferedBlockCipher( mode );\r\n\r\n            return cipher.DoFinal( input );\r\n        }\r\n    }"
        },
        {
          "Title": "MBus.Extensions.Decryption.AesCtrCrypto.Decrypt(byte[])",
          "Kind": "Method",
          "StartLine": 24,
          "EndLine": 29,
          "Code": "\r\n        public byte[] Decrypt( byte[] bytes )\r\n        {\r\n            return BouncyCastleCrypto( forEncrypt: false, bytes, _key, _iv );\r\n        }\r\n"
        },
        {
          "Title": "MBus.Extensions.Decryption.AesCtrCrypto.Encrypt(byte[])",
          "Kind": "Method",
          "StartLine": 29,
          "EndLine": 34,
          "Code": "\r\n        public byte[] Encrypt( byte[] bytes )\r\n        {\r\n            return BouncyCastleCrypto( forEncrypt: true, bytes, _key, _iv );\r\n        }\r\n"
        }
      ]
