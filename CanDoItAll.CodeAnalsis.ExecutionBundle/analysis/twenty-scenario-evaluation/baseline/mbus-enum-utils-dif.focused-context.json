          "Kind": "Method",
          "StartLine": 21,
          "EndLine": 31,
          "Code": "        /// \u003Creturns\u003E\u003Cparamref name=\u0022value\u0022/\u003E as type \u003Ctypeparamref name=\u0022T\u0022/\u003E or \u003Cparamref name=\u0022defaultValue\u0022/\u003E\u003C/returns\u003E\r\n        public static T GetEnumOrDefault\u003CT\u003E(object value, T defaultValue)\r\n        {\r\n            if (!Enum.IsDefined(typeof(T), value))\r\n            {\r\n                return defaultValue;\r\n            }\r\n\r\n            return (T)value;\r\n        }\r\n"
        }
