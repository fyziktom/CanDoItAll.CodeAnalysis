          "Title": "MBus.MBusParser.ParsePayload(MBus.Header.MBusHeader, System.Collections.Generic.IList\u003Cbyte\u003E, byte[])",
          "Kind": "Method",
          "StartLine": 41,
          "EndLine": 61,
          "Code": "        /// \u003Creturns\u003Ethe mbus telegram.\u003C/returns\u003E\r\n        public MBusTelegram ParsePayload(MBusHeader header, IList\u003Cbyte\u003E payload, byte[] decryptionKey = null)\r\n        {\r\n            double? rssi = null;\r\n            // todo refactor to be able to return rssi\r\n\r\n            if (header.IsWireless)\r\n            {\r\n                // TODO: only if the last byte is an RSSI byte, we should remove it from the payload.\r\n                //rssi = -payload.Last() / 2;\r\n                //payload = payload.Take(payload.Count - 1).ToArray();\r\n            }\r\n\r\n            IList\u003CVariableDataRecord\u003E? records = this.ParseRecords(\r\n                header,\r\n                payload,\r\n                decryptionKey);\r\n\r\n            return new MBusTelegram(header, records, rssi);\r\n        }\r\n"
        }
      ]
    },
    {
      "Path": "MbusParser/Header/Configuration.cs",
      "TotalLineCount": 51,
      "SelectedLineCount": 17,
      "TypeDisplayNames": [
        "MBus.Header.Configuration"
      ],
      "Blocks": [
        {
          "Title": "MBus.Header.Configuration.GetEncryptionScheme(byte)",
          "Kind": "Method",
          "StartLine": 34,
          "EndLine": 50,
          "Code": "\r\n        private EncryptionScheme GetEncryptionScheme(byte encryptionSchemeByte)\r\n        {\r\n            var enc = encryptionSchemeByte.GetLowNibble();\r\n\r\n            switch (enc)\r\n            {\r\n                case 0b0000_0000: return EncryptionScheme.NoEncryption;\r\n                case 0b0000_0001: return EncryptionScheme.AesCtr;\r\n                case 0b0000_0011: return EncryptionScheme.DesCbcIvIsZero;\r\n                case 0b0000_0100: return EncryptionScheme.DesCbc;\r\n                case 0b0000_0101: return EncryptionScheme.AesCbc;\r\n            }\r\n\r\n            return EncryptionScheme.Unknown;\r\n        }\r\n    }"
        }
      ]
    },
