<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>CanDoItAll contributors</Authors>
    <Company>CanDoItAll</Company>
    <Product>CanDoItAll.CodeAnalytics</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fyziktom/CanDoItAll.CodeAnalsis</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fyziktom/CanDoItAll.CodeAnalsis.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>code-analysis;roslyn;architecture;dependency-analysis;mermaid</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      .artifacts/**;
      .mcp-state/**;
      output/**;
      playwright-report/**;
      test-results/**;
      TestResults/**;
      coverage/**;
      screenshots/**;
    </DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
