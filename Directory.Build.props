<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>CanDoItAll contributors</Authors>
    <Company>CanDoItAll</Company>
    <Product>CanDoItAll.CodeAnalytics</Product>
    <PackageProjectUrl>https://aicandoitall.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fyziktom/CanDoItAll.CodeAnalysis.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>code-analysis;roslyn;architecture;dependency-analysis;mermaid</PackageTags>
    <CanDoItAllPackageBaseVersion Condition="'$(CanDoItAllPackageBaseVersion)' == ''">0.1.0</CanDoItAllPackageBaseVersion>
    <CanDoItAllPackageProofSuffix Condition="'$(CanDoItAllPackageProofSuffix)' == ''"></CanDoItAllPackageProofSuffix>
    <Version>$(CanDoItAllPackageBaseVersion)$(CanDoItAllPackageProofSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <DefaultItemExcludes>
      $(DefaultItemExcludes);
      .artifacts/**;
      .mcp-state/**;
      output/**;
      playwright-report/**;
      test-results/**;
      TestResults/**;
      coverage/**;
      screenshots/**;
    </DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
