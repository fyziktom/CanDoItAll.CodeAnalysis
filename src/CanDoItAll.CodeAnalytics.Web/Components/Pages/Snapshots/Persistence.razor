@page "/snapshots/{SnapshotId}/persistence"

<PageTitle>Persistence</PageTitle>

@if (_response is null)
{
    <div class="panel">
        <h1>Persistence</h1>
        <p class="empty-state">The requested snapshot could not be loaded.</p>
    </div>
}
else
{
    <div class="page-shell">
        <header class="panel">
            <h1>Persistence</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" ActiveTab="persistence" />
            <form method="get" class="search-form">
                <input type="text" name="search" value="@Search" placeholder="Filter entities" />
                <button type="submit">Filter</button>
            </form>
        </header>

        <section class="panel">
            <h2>DbContexts</h2>
            @if (_response.DbContexts.Count == 0)
            {
                <p class="empty-state">No DbContexts matched the current filter.</p>
            }
            else
            {
                <div class="type-browser-grid">
                    @foreach (var dbContext in _response.DbContexts)
                    {
                        <article class="type-browser-card">
                            <div class="type-browser-header">
                                <h3>@dbContext.DisplayName</h3>
                                <span class="severity-pill severity-info">@dbContext.EntityTypeIds.Count entities</span>
                            </div>
                            <p class="field-help">@dbContext.Source.Path:@dbContext.Source.Line</p>
                            <div class="metadata-row">
                                @foreach (var entityName in GetEntityNames(dbContext.EntityTypeIds))
                                {
                                    <span>@entityName</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel">
            <h2>Entities</h2>
            @if (_response.Entities.Count == 0)
            {
                <p class="empty-state">No entities matched the current filter.</p>
            }
            else
            {
                <div class="type-browser-grid">
                    @foreach (var entity in _response.Entities)
                    {
                        <article class="type-browser-card">
                            <div class="type-browser-header">
                                <h3>@entity.DisplayName</h3>
                                <span class="severity-pill severity-info">entity</span>
                            </div>
                            <div class="metadata-row">
                                <span><strong>Table</strong> @GetStoreObjectName(entity)</span>
                                <span><strong>Keys</strong> @FormatKeys(entity)</span>
                                <span><strong>Relations</strong> @entity.RelationshipTargets.Count</span>
                                <span><strong>Source</strong> @entity.Source.Path</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel">
            <h2>Collector diagnostics</h2>
            @if (_response.Diagnostics.Count == 0)
            {
                <p class="empty-state">No persistence diagnostics were produced.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var diagnostic in _response.Diagnostics)
                    {
                        <li><strong>@diagnostic.Code</strong> @diagnostic.Message</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private PersistenceViewResponse? _response;
    private Dictionary<string, string> _entityNamesById = [];

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetPersistenceAsync(new SnapshotQuery(SnapshotId, Search));
        _entityNamesById = _response?.Entities.ToDictionary(entity => entity.EntityId, entity => entity.DisplayName, StringComparer.Ordinal) ?? [];
    }

    private IEnumerable<string> GetEntityNames(IReadOnlyList<string> entityIds)
    {
        return entityIds
            .Select(entityId => _entityNamesById.TryGetValue(entityId, out var entityName) ? entityName : entityId)
            .OrderBy(entityName => entityName, StringComparer.Ordinal);
    }

    private static string FormatKeys(EntityFact entity)
    {
        return entity.KeyPropertyNames.Count == 0
            ? "None detected"
            : string.Join(", ", entity.KeyPropertyNames);
    }

    private static string GetStoreObjectName(EntityFact entity)
    {
        if (!string.IsNullOrWhiteSpace(entity.TableName) && !string.IsNullOrWhiteSpace(entity.Schema)) {
            return $"{entity.Schema}.{entity.TableName}";
        }

        if (!string.IsNullOrWhiteSpace(entity.TableName)) {
            return entity.TableName;
        }

        if (!string.IsNullOrWhiteSpace(entity.Schema)) {
            return $"schema {entity.Schema}";
        }

        return "Convention or unresolved";
    }
}
