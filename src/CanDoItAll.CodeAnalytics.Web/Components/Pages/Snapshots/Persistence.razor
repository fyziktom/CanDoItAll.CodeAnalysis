@page "/snapshots/{SnapshotId}/persistence"

<PageTitle>Persistence</PageTitle>

@if (_response is null)
{
    <div class="panel">
        <h1>Persistence</h1>
        <p class="empty-state">The requested snapshot could not be loaded.</p>
    </div>
}
else
{
    <div class="page-shell">
        <header class="panel">
            <h1>Persistence</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" ActiveTab="persistence" />
            <form method="get" class="search-form">
                <input type="text" name="search" value="@Search" placeholder="Filter entities" />
                <button type="submit">Filter</button>
            </form>
        </header>

        <section class="panel">
            <h2>DbContexts</h2>
            <ul class="detail-list">
                @foreach (var dbContext in _response.DbContexts)
                {
                    <li>@dbContext.DisplayName (@dbContext.EntityTypeIds.Count entities)</li>
                }
            </ul>
        </section>

        <section class="panel">
            <h2>Entities</h2>
            <ul class="detail-list">
                @foreach (var entity in _response.Entities)
                {
                    <li>@entity.DisplayName -> table @entity.TableName</li>
                }
            </ul>
        </section>

        <section class="panel">
            <h2>Collector diagnostics</h2>
            @if (_response.Diagnostics.Count == 0)
            {
                <p class="empty-state">No persistence diagnostics were produced.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var diagnostic in _response.Diagnostics)
                    {
                        <li><strong>@diagnostic.Code</strong> @diagnostic.Message</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private PersistenceViewResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetPersistenceAsync(new SnapshotQuery(SnapshotId, Search));
    }
}
