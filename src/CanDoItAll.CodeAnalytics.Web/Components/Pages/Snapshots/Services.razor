@page "/snapshots/{SnapshotId}/services"

<PageTitle>Services</PageTitle>

@if (_response is null)
{
    <div class="panel">
        <h1>Services</h1>
        <p class="empty-state">The requested snapshot could not be loaded.</p>
    </div>
}
else
{
    <div class="page-shell">
        <header class="panel">
            <h1>Services</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" ActiveTab="services" />
            <form method="get" class="search-form">
                <input type="text" name="search" value="@Search" placeholder="Filter services" />
                <button type="submit">Filter</button>
            </form>
        </header>

        <section class="panel">
            <ul class="detail-list">
                @foreach (var service in _response.Services)
                {
                    <li><strong>@service.ServiceTypeDisplayName</strong> -> @service.ImplementationTypeDisplayName (@service.Lifetime)</li>
                }
            </ul>
        </section>

        <section class="panel">
            <h2>Collector diagnostics</h2>
            @if (_response.Diagnostics.Count == 0)
            {
                <p class="empty-state">No DI diagnostics were produced.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var diagnostic in _response.Diagnostics)
                    {
                        <li><strong>@diagnostic.Code</strong> @diagnostic.Message</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private ServiceViewResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetServicesAsync(new SnapshotQuery(SnapshotId, Search));
    }
}
