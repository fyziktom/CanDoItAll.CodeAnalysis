@page "/snapshots/{SnapshotId}/context"

<PageTitle>Focused Context</PageTitle>

@if (_response is null)
{
    <div class="panel">
        <h1>Focused Context</h1>
        <SnapshotTabs SnapshotId="@SnapshotId" />
        <p class="empty-state">Select a type, function, or service from the snapshot drilldown pages to open a bounded code neighborhood.</p>
    </div>
}
else
{
    <div class="page-shell">
        <header class="panel">
            <span class="eyebrow">Focused context</span>
            <h1>Focused Context</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" />
            <p class="form-note">The context graph stays bounded around the selected seed so the next step can stay targeted.</p>
            <form method="get" class="search-form type-search-form">
                @if (!string.IsNullOrWhiteSpace(TypeId))
                {
                    <input type="hidden" name="typeId" value="@TypeId" />
                }
                @if (!string.IsNullOrWhiteSpace(MemberId))
                {
                    <input type="hidden" name="memberId" value="@MemberId" />
                }
                @if (!string.IsNullOrWhiteSpace(ServiceId))
                {
                    <input type="hidden" name="serviceId" value="@ServiceId" />
                }
                <select name="depth">
                    @for (var depthOption = 0; depthOption <= 5; depthOption++)
                    {
                        <option value="@depthOption" selected="@(depthOption == _response.Depth)">@depthOption hop(s)</option>
                    }
                </select>
                <button type="submit">Update depth</button>
            </form>
        </header>

        <section class="panel">
            <div class="metadata-row">
                @if (_response.SeedService is not null)
                {
                    <span><strong>Service</strong> @_response.SeedService.ServiceTypeDisplayName</span>
                }
                @if (_response.SeedType is not null)
                {
                    <span><strong>Type</strong> @_response.SeedType.DisplayName</span>
                }
                @if (_response.SeedMember is not null)
                {
                    <span><strong>Member</strong> @_response.SeedMember.DisplayName</span>
                }
                <span><strong>Depth</strong> @_response.Depth</span>
                <span><strong>Intent</strong> @GetIntentLabel(_response.ResolvedIntent)</span>
                <span><strong>Precision</strong> @GetPrecisionLabel(_response.ResolvedPrecision)</span>
                <span><strong>Types</strong> @_response.Types.Count</span>
                <span><strong>Members</strong> @_response.Members.Count</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_response.StrategyExplanation))
            {
                <p class="field-help">@_response.StrategyExplanation</p>
            }
        </section>

        @if (_response.UsageSummary is not null)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>Usage Summary</h2>
                    <p>Grouped callers keep widespread helpers readable without pulling every consumer into the focused excerpt set.</p>
                </div>

                <div class="summary-grid">
                    <div class="stat-card">
                        <span class="stat-label">Total callers</span>
                        <span class="stat-value-sm">@_response.UsageSummary.TotalCallerCount</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Clusters</span>
                        <span class="stat-value-sm">@_response.UsageSummary.Clusters.Count / @_response.UsageSummary.TotalClusterCount</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Omitted callers</span>
                        <span class="stat-value-sm">@_response.UsageSummary.OmittedCallerCount</span>
                    </div>
                </div>

                <ul class="detail-list">
                    @foreach (var cluster in _response.UsageSummary.Clusters)
                    {
                        <li>
                            <strong>@cluster.ProjectName</strong>
                            @if (!string.IsNullOrWhiteSpace(cluster.ModuleName))
                            {
                                <span> @cluster.ModuleName </span>
                            }
                            <span>@cluster.CallerCount caller(s)</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_response.ImplementationTypes.Count > 0)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>Implementations</h2>
                    <p>These concrete types are treated as definition-adjacent context for helper-like seeds.</p>
                </div>

                <ul class="detail-list">
                    @foreach (var type in _response.ImplementationTypes)
                    {
                        <li><strong>@type.DisplayName</strong> <span>@type.Source.Path:@type.Source.Line</span></li>
                    }
                </ul>
            </section>
        }

        <section class="panel">
            <div class="panel-heading">
                <h2>Reference helpers</h2>
                <p>These are high-traffic collaborators in the same project scope that are worth keeping in working memory.</p>
            </div>
            @if (_response.ReferenceTypes.Count == 0)
            {
                <p class="empty-state">No reference helpers were identified for the current scope.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var type in _response.ReferenceTypes)
                    {
                        <li><a href="@GetTypeContextHref(type.TypeId)">@type.DisplayName</a> <span>@type.Source.Path:@type.Source.Line</span></li>
                    }
                </ul>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Types</h2>
                <p>Summaries and source anchors for the classes currently inside the focused neighborhood.</p>
            </div>
            <div class="type-browser-grid">
                @foreach (var type in _response.Types)
                {
                    <article class="type-browser-card">
                        <div class="type-browser-header">
                            <div>
                                <h3>@type.DisplayName</h3>
                                <p class="field-help">@type.Source.Path:@type.Source.Line</p>
                            </div>
                            <span class="severity-pill severity-info">@type.Kind</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(type.XmlSummary))
                        {
                            <p>@type.XmlSummary</p>
                        }
                        <div class="action-links">
                            <a href="@GetTypeContextHref(type.TypeId)">Recenter on this type</a>
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Members</h2>
                <p>These functions and members sit inside the selected neighborhood.</p>
            </div>
            <div class="member-list">
                @foreach (var member in _response.Members)
                {
                    <article class="member-card">
                        <div class="progress-meta">
                            <span class="severity-pill severity-info">@member.Kind</span>
                            <strong>@member.DisplayName</strong>
                        </div>
                        <p>@member.ReturnTypeDisplayName</p>
                        @if (member.ParameterDisplayNames.Count > 0)
                        {
                            <p>Parameters: @string.Join(", ", member.ParameterDisplayNames)</p>
                        }
                        <p class="field-help">@member.Source.Path:@member.Source.Line</p>
                    </article>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Member relations</h2>
                <p>Edges are grouped from the canonical member graph, with a representative source anchor.</p>
            </div>
            @if (_response.MemberRelationships.Count == 0)
            {
                <p class="empty-state">No member-level relations were found in the selected neighborhood.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var relationship in _response.MemberRelationships)
                    {
                        <li>
                            <strong>@GetMemberName(relationship.FromMemberId)</strong>
                            <span> @relationship.Kind </span>
                            <strong>@GetMemberName(relationship.ToMemberId)</strong>
                            @if (relationship.Source is not null)
                            {
                                <span> (@relationship.Source.Path:@relationship.Source.Line)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Type relations</h2>
                <p>These type edges keep the class neighborhood visible without falling back to a whole-solution graph.</p>
            </div>
            @if (_response.TypeRelationships.Count == 0)
            {
                <p class="empty-state">No type-level relations were found in the selected neighborhood.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var relationship in _response.TypeRelationships)
                    {
                        <li>
                            <strong>@GetTypeName(relationship.FromTypeId)</strong>
                            <span> @relationship.Kind </span>
                            <strong>@GetTypeName(relationship.ToTypeId)</strong>
                            @if (relationship.Source is not null)
                            {
                                <span> (@relationship.Source.Path:@relationship.Source.Line)</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="panel">
            <div class="panel-heading">
                <h2>Related services</h2>
                <p>Service registrations that map onto the current neighborhood.</p>
            </div>
            @if (_response.RelatedServices.Count == 0)
            {
                <p class="empty-state">No related services were found.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var service in _response.RelatedServices)
                    {
                        <li><strong>@service.ServiceTypeDisplayName</strong> -> @service.ImplementationTypeDisplayName (@service.Lifetime)</li>
                    }
                </ul>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "typeId")]
    public string? TypeId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "memberId")]
    public string? MemberId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "serviceId")]
    public string? ServiceId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "depth")]
    public int? Depth { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private FocusedContextResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetFocusedContextAsync(
            new FocusedContextQuery(
                SnapshotId,
                TypeId,
                MemberId,
                ServiceId,
                Depth ?? 2));
    }

    private string GetTypeContextHref(string typeId)
    {
        return $"/snapshots/{SnapshotId}/context?typeId={Uri.EscapeDataString(typeId)}";
    }

    private string GetTypeName(string typeId)
    {
        return _response?.Types.FirstOrDefault(item => string.Equals(item.TypeId, typeId, StringComparison.Ordinal))?.DisplayName ?? typeId;
    }

    private string GetMemberName(string memberId)
    {
        return _response?.Members.FirstOrDefault(item => string.Equals(item.MemberId, memberId, StringComparison.Ordinal))?.DisplayName ?? memberId;
    }

    private static string GetIntentLabel(FocusedContextIntent intent)
    {
        return intent switch
        {
            FocusedContextIntent.TroublePath => "Trouble path",
            FocusedContextIntent.UsageSummary => "Usage summary",
            FocusedContextIntent.RepresentativeConsumers => "Representative consumers",
            _ => intent.ToString(),
        };
    }

    private static string GetPrecisionLabel(FocusedContextPrecision precision)
    {
        return precision switch
        {
            FocusedContextPrecision.Auto => "Auto",
            FocusedContextPrecision.Balanced => "Balanced",
            FocusedContextPrecision.Surgical => "Surgical",
            _ => precision.ToString(),
        };
    }
}
