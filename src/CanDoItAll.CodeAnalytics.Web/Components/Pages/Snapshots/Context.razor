@page "/snapshots/{SnapshotId}/context"

<PageTitle>Focused Context</PageTitle>

@if (_response is null)
{
    <SectionCard>
        <h1>Focused Context</h1>
        <SnapshotTabs SnapshotId="@SnapshotId" />
        <p class="empty-state">Select a type, function, or service from the snapshot drilldown pages to open a bounded code neighborhood.</p>
    </SectionCard>
}
else
{
    <div class="page-shell">
        <SectionCard>
            <span class="eyebrow">Focused context</span>
            <h1>Focused Context</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" />
            <p class="form-note">The context graph stays bounded around the selected seed so the next step can stay targeted.</p>
            <form method="get" class="search-form type-search-form">
                @if (!string.IsNullOrWhiteSpace(TypeId))
                {
                    <input type="hidden" name="typeId" value="@TypeId" />
                }
                @if (!string.IsNullOrWhiteSpace(MemberId))
                {
                    <input type="hidden" name="memberId" value="@MemberId" />
                }
                @if (!string.IsNullOrWhiteSpace(ServiceId))
                {
                    <input type="hidden" name="serviceId" value="@ServiceId" />
                }
                <select name="depth">
                    @for (var depthOption = 0; depthOption <= 5; depthOption++)
                    {
                        <option value="@depthOption" selected="@(depthOption == _response.Depth)">@depthOption hop(s)</option>
                    }
                </select>
                <button type="submit">Update depth</button>
            </form>
        </SectionCard>

        <SectionCard>
            <div class="metadata-row">
                @if (_response.SeedService is not null)
                {
                    <span><strong>Service</strong> @_response.SeedService.ServiceTypeDisplayName</span>
                }
                @if (_response.SeedType is not null)
                {
                    <span><strong>Type</strong> @_response.SeedType.DisplayName</span>
                }
                @if (_response.SeedMember is not null)
                {
                    <span><strong>Member</strong> @_response.SeedMember.DisplayName</span>
                }
                <span><strong>Depth</strong> @_response.Depth</span>
                <span><strong>Intent</strong> @GetIntentLabel(_response.ResolvedIntent)</span>
                <span><strong>Precision</strong> @GetPrecisionLabel(_response.ResolvedPrecision)</span>
                <span><strong>Types</strong> @_response.Types.Count</span>
                <span><strong>Members</strong> @_response.Members.Count</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_response.StrategyExplanation))
            {
                <p class="field-help">@_response.StrategyExplanation</p>
            }
        </SectionCard>

        <FocusedContextUsageSummaryPanel UsageSummary="_response.UsageSummary" />
        <FocusedContextDetailsPanel
            Response="_response"
            SnapshotId="@SnapshotId"
            LinkTypes="@true" />
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "typeId")]
    public string? TypeId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "memberId")]
    public string? MemberId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "serviceId")]
    public string? ServiceId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "depth")]
    public int? Depth { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private FocusedContextResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetFocusedContextAsync(
            new FocusedContextQuery(
                SnapshotId,
                TypeId,
                MemberId,
                ServiceId,
                Depth ?? 2));
    }

    private static string GetIntentLabel(FocusedContextIntent intent)
    {
        return intent switch
        {
            FocusedContextIntent.TroublePath => "Trouble path",
            FocusedContextIntent.UsageSummary => "Usage summary",
            FocusedContextIntent.RepresentativeConsumers => "Representative consumers",
            _ => intent.ToString(),
        };
    }

    private static string GetPrecisionLabel(FocusedContextPrecision precision)
    {
        return precision switch
        {
            FocusedContextPrecision.Auto => "Auto",
            FocusedContextPrecision.Balanced => "Balanced",
            FocusedContextPrecision.Surgical => "Surgical",
            FocusedContextPrecision.Outline => "Outline",
            _ => precision.ToString(),
        };
    }

}
