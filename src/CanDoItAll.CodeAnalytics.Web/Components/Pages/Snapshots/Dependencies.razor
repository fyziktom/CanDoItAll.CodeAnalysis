@page "/snapshots/{SnapshotId}/dependencies"

<PageTitle>Dependencies</PageTitle>

@if (_response is null)
{
    <SectionCard>
        <h1>Dependencies</h1>
        <p class="empty-state">The requested snapshot could not be loaded.</p>
    </SectionCard>
}
else
{
    <div class="page-shell">
        <SectionCard>
            <h1>Dependencies</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" ActiveTab="dependencies" />
            <form method="get" class="search-form">
                <input type="text" name="search" value="@Search" placeholder="Filter modules" />
                <button type="submit">Filter</button>
            </form>
        </SectionCard>

        <SectionCard>
            <h2>Modules</h2>
            <ul class="detail-list">
                @foreach (var module in _response.Modules)
                {
                    <li>@module.Name (@module.TypeIds.Count types)</li>
                }
            </ul>
        </SectionCard>

        <SectionCard>
            <h2>Cycles</h2>
            @if (_response.Cycles.Count == 0)
            {
                <p class="empty-state">No cycles were detected.</p>
            }
            else
            {
                <ul class="detail-list">
                    @foreach (var cycle in _response.Cycles)
                    {
                        <li>@cycle.Level: @string.Join(" -> ", cycle.NodeIds)</li>
                    }
                </ul>
            }
        </SectionCard>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private DependencyViewResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetDependenciesAsync(new SnapshotQuery(SnapshotId, Search));
    }
}
