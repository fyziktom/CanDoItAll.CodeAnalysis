@page "/snapshots/{SnapshotId}/exports"

<PageTitle>Exports</PageTitle>

@if (_response is null)
{
    <div class="panel">
        <h1>Exports</h1>
        <p class="empty-state">The requested snapshot could not be loaded.</p>
    </div>
}
else
{
    <div class="page-shell">
        <header class="panel">
            <h1>Exports</h1>
            <SnapshotTabs SnapshotId="@SnapshotId" ActiveTab="exports" />
        </header>

        <section class="panel">
            <ul class="detail-list">
                @foreach (var artifact in _response.Artifacts)
                {
                    <li>
                        <a href="@GetExportHref(artifact.RelativePath)">@artifact.Title</a>
                        <span> @artifact.Description</span>
                    </li>
                }
            </ul>
        </section>
    </div>
}

@code {
    [Parameter]
    public string SnapshotId { get; set; } = string.Empty;

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    private ExportsViewResponse? _response;

    protected override async Task OnParametersSetAsync()
    {
        _response = await ApplicationService.GetExportsAsync(SnapshotId);
    }

    private string GetExportHref(string relativePath)
    {
        return $"/exports/{SnapshotId}/{relativePath}";
    }
}
