@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Error</PageTitle>

<section class="panel">
    <div class="panel-heading">
        <h1>Unhandled error</h1>
        <p>The request failed outside the normal analysis flow. Check the operation page and application logs for the full context.</p>
    </div>

    <div class="diagnostic-list">
        <article class="diagnostic-item">
            <div class="progress-meta">
                <span class="severity-pill severity-error">Error</span>
                <strong>Request</strong>
                <span>@RequestId</span>
            </div>
            <p>@ErrorMessage</p>
        </article>
    </div>

    @if (ShowRequestPath)
    {
        <p class="field-help">Path: <code>@RequestPath</code></p>
    }
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string RequestId { get; set; } = "unknown";
    private string ErrorMessage { get; set; } = "An unexpected server error occurred.";
    private string? RequestPath { get; set; }
    private bool ShowRequestPath => !string.IsNullOrWhiteSpace(RequestPath);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier ?? "unknown";

        var exceptionFeature = HttpContext?.Features.Get<IExceptionHandlerPathFeature>();
        if (exceptionFeature is null) {
            return;
        }

        RequestPath = exceptionFeature.Path;
        if (exceptionFeature.Error is not null) {
            ErrorMessage = exceptionFeature.Error.Message;
        }
    }
}
