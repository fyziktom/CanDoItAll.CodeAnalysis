@page "/context-lab"

<PageTitle>Focused Context Lab</PageTitle>

<div class="page-shell">
    <header class="hero">
        <span class="eyebrow">Focused context tuning</span>
        <h1>Focused Context Lab</h1>
        <p>
            Run a bounded focused-context pass from plain prompt text, optional project scope, and explicit tags.
            The goal is to judge whether the selected excerpts are precise enough before an agent starts reading whole files.
        </p>
    </header>

    <section class="panel">
        <div class="panel-heading">
            <h2>Run Lab</h2>
            <p>Snapshots are reused when possible, so repeated tuning runs stay fast unless you force a refresh.</p>
        </div>

        <form class="analysis-form" method="get">
            <label class="field">
                <span>Solution or project path</span>
                <div class="path-picker">
                    <input id="labWorkspacePathInput" type="text" name="workspacePath" value="@GetWorkspacePath()" />
                    <button
                        class="secondary-button"
                        type="button"
                        data-workspace-picker
                        data-target-id="labWorkspacePathInput"
                        data-status-id="labPickerStatus">
                        Browse
                    </button>
                </div>
                <small class="field-help">
                    Choose a <code>.sln</code>, <code>.slnx</code>, or <code>.csproj</code>. Use the project filter only when the workspace is a solution.
                </small>
                <output class="picker-status" id="labPickerStatus" aria-live="polite"></output>
            </label>

            <label class="field">
                <span>Project filter</span>
                <input type="text" name="projectFilter" value="@ProjectFilter" placeholder="Optional comma-separated project names" />
                <small class="field-help">This narrows a solution run before the focused-context query starts.</small>
            </label>

            <label class="field">
                <span>Prompt text</span>
                <textarea name="queryText" rows="4" placeholder="Exception text, compile error, method name, class name, or a short trouble description">@QueryText</textarea>
                <small class="field-help">
                    The resolver first tries diagnostics, then members, types, and services. Use a specific method or class name when you want predictable matching.
                </small>
            </label>

            <label class="field">
                <span>Tags</span>
                <input type="text" name="tags" value="@Tags" placeholder="Optional tags such as Db, Ui, Service" />
                <small class="field-help">Tags bias the traversal instead of expanding it without limits.</small>
            </label>

            <label class="field">
                <span>Relation hints</span>
                <input type="text" name="relationHints" value="@RelationHints" placeholder="Optional related classes, methods, components, projects, or paths" />
                <small class="field-help">Use this when you need a seed plus a related area, such as <code>IClock</code> with <code>Workbench</code> or <code>DashboardPage</code>.</small>
            </label>

            <div class="summary-grid">
                <label class="field">
                    <span>Intent</span>
                    <select name="intent">
                        @foreach (var intentOption in Enum.GetValues<FocusedContextIntent>())
                        {
                            <option value="@intentOption" selected="@(intentOption == GetIntent())">@GetIntentLabel(intentOption)</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span>Precision</span>
                    <select name="precision">
                        @foreach (var precisionOption in Enum.GetValues<FocusedContextPrecision>())
                        {
                            <option value="@precisionOption" selected="@(precisionOption == GetPrecision())">@GetPrecisionLabel(precisionOption)</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span>Depth</span>
                    <select name="depth">
                        @for (var depthOption = 0; depthOption <= 5; depthOption++)
                        {
                            <option value="@depthOption" selected="@(depthOption == GetDepth())">@depthOption hop(s)</option>
                        }
                    </select>
                </label>

                <label class="search-toggle lab-toggle">
                    <input type="checkbox" name="forceRefresh" value="true" checked="@ForceRefresh" />
                    <span>Force refresh snapshot</span>
                </label>
            </div>

            <div class="action-row">
                <button class="primary-button" type="submit">Run focused context</button>
                <a class="secondary-link-button" href="/">Back to analysis home</a>
            </div>
        </form>
    </section>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="panel">
            <p class="message-banner error-banner">@_errorMessage</p>
        </section>
    }
    else if (_buildResponse is not null && _response is null)
    {
        <section class="panel">
            <p class="message-banner warning-banner">A snapshot was built, but the prompt did not resolve to a bounded seed.</p>
        </section>
    }

    @if (_buildResponse is not null)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>Run Summary</h2>
                <p>Use this to judge whether the heuristic picked the right neighborhood before opening whole files.</p>
            </div>

            <div class="summary-grid">
                <div class="stat-card">
                    <span class="stat-label">Snapshot</span>
                    <strong class="path-text">@_buildResponse.Snapshot.SnapshotId</strong>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Cache</span>
                    <span class="stat-value-sm">@(_buildResponse.FromCache ? "Reused" : "Fresh")</span>
                </div>
                <div class="stat-card">
                    <span class="stat-label">Diagnostics</span>
                    <span class="stat-value-sm">@_buildResponse.Diagnostics.Count</span>
                </div>
                @if (_response is not null)
                {
                    <div class="stat-card">
                        <span class="stat-label">Selected Lines</span>
                        <span class="stat-value-sm">@_response.Stats.SelectedLineCount</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Selection quality</span>
                        <span class="stat-value-sm">@GetSelectionQuality()</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Intent</span>
                        <span class="stat-value-sm">@GetIntentLabel(_response.ResolvedIntent)</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Precision</span>
                        <span class="stat-value-sm">@GetPrecisionLabel(_response.ResolvedPrecision)</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Selection reasons</span>
                        <span class="stat-value-sm">@_response.SelectionReasons.Count</span>
                    </div>
                }
            </div>

            @if (_response is not null)
            {
                <div class="metadata-row">
                    @if (!string.IsNullOrWhiteSpace(_response.SeedExplanation))
                    {
                        <span><strong>Seed</strong> @_response.SeedExplanation</span>
                    }
                    @if (_response.SeedType is not null)
                    {
                        <span><strong>Type</strong> @_response.SeedType.DisplayName</span>
                    }
                    @if (_response.SeedMember is not null)
                    {
                        <span><strong>Member</strong> @_response.SeedMember.DisplayName</span>
                    }
                    @if (_response.SeedService is not null)
                    {
                        <span><strong>Service</strong> @_response.SeedService.ServiceTypeDisplayName</span>
                    }
                    <span><strong>Files</strong> @_response.Stats.FileCount</span>
                    <span><strong>Blocks</strong> @_response.Stats.BlockCount</span>
                    <span><strong>Total file lines</strong> @_response.Stats.TotalLineCount</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(_response.StrategyExplanation))
                {
                    <p class="field-help">@_response.StrategyExplanation</p>
                }

                @if (_response.FocusTags.Count > 0)
                {
                    <div class="chip-row">
                        @foreach (var focusTag in _response.FocusTags)
                        {
                            <span class="severity-pill severity-info">@focusTag</span>
                        }
                    </div>
                }

                @if (_response.RelationHints.Count > 0)
                {
                    <div class="chip-row">
                        @foreach (var relationHint in _response.RelationHints)
                        {
                            <span class="severity-pill severity-info">@relationHint</span>
                        }
                    </div>
                }

                @if (HasBroadSelection())
                {
                    <p class="message-banner warning-banner">
                        This run still looks broad. One or more files are carrying large excerpts, so the graph likely needs another scoring or traversal adjustment.
                    </p>
                }

                @if (_response.ResolvedPrecision == FocusedContextPrecision.Outline)
                {
                    <p class="message-banner warning-banner">
                        Outline precision keeps symbol paths, counts, and usage breadth without carrying code excerpts.
                    </p>
                }
            }
        </section>
    }

    @if (_response is not null)
    {
        <section class="panel">
            <div class="panel-heading">
                <h2>Selected Files</h2>
                <p>Each accordion shows only the code the analyzer decided was worth carrying into working memory.</p>
            </div>

            @if (_response.Files.Count == 0)
            {
                <p class="empty-state">@GetSelectedFilesEmptyState()</p>
            }
            else
            {
                <div class="accordion-list">
                    @foreach (var file in _response.Files)
                    {
                        <details class="file-accordion" open="@IsSeedFile(file.Path)">
                            <summary class="file-summary">
                                <strong>@file.Path</strong>
                                <span>@file.SelectedLineCount selected / @file.TotalLineCount total lines</span>
                                <span>@file.Blocks.Count block(s)</span>
                                @if (IsBroadFile(file))
                                {
                                    <span class="severity-pill severity-warning">Broad excerpt</span>
                                }
                            </summary>

                            @if (file.TypeDisplayNames.Count > 0)
                            {
                                <p class="field-help">Types: @string.Join(", ", file.TypeDisplayNames)</p>
                            }

                            @{
                                var fileReasonSummary = GetReasonSummary(FocusedContextSelectionTargetKind.File, file.Path);
                            }
                            @if (!string.IsNullOrWhiteSpace(fileReasonSummary))
                            {
                                <p class="field-help">Selection: @fileReasonSummary</p>
                            }

                            <div class="code-block-list">
                                @foreach (var block in file.Blocks)
                                {
                                    <article class="code-block">
                                        <div class="progress-meta">
                                            <span class="severity-pill severity-info">@block.Kind</span>
                                            <strong>@block.Title</strong>
                                            <span>Lines @block.StartLine-@block.EndLine</span>
                                        </div>
                                        <pre class="code-snippet"><code>@block.Code</code></pre>
                                    </article>
                                }
                            </div>
                        </details>
                    }
                </div>
            }
        </section>

        @if (_response.UsageSummary is not null)
        {
            <section class="panel">
                <div class="panel-heading">
                    <h2>Usage Summary</h2>
                    <p>Helper callers are grouped by project or module so breadth stays visible without dragging every consumer into the excerpt set.</p>
                </div>

                <div class="summary-grid">
                    <div class="stat-card">
                        <span class="stat-label">Total callers</span>
                        <span class="stat-value-sm">@_response.UsageSummary.TotalCallerCount</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Clusters</span>
                        <span class="stat-value-sm">@_response.UsageSummary.Clusters.Count / @_response.UsageSummary.TotalClusterCount</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Omitted callers</span>
                        <span class="stat-value-sm">@_response.UsageSummary.OmittedCallerCount</span>
                    </div>
                </div>

                <div class="accordion-list">
                    @foreach (var cluster in _response.UsageSummary.Clusters)
                    {
                        <details class="file-accordion">
                            <summary class="file-summary">
                                <strong>@cluster.ProjectName</strong>
                                @if (!string.IsNullOrWhiteSpace(cluster.ModuleName))
                                {
                                    <span>@cluster.ModuleName</span>
                                }
                                <span>@cluster.CallerCount caller(s)</span>
                            </summary>

                            <ul class="detail-list">
                                @foreach (var sample in cluster.Samples)
                                {
                                    <li>
                                        <strong>@sample.TypeDisplayName</strong>
                                        <span>@sample.MemberDisplayName</span>
                                        <span>@sample.Path:@sample.Line</span>
                                        <span>@sample.Reason</span>
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                </div>
            </section>
        }

        <section class="panel">
            <div class="panel-heading">
                <h2>Supporting Context</h2>
                <p>These sections help explain why the file excerpts were chosen and what you should tune next.</p>
            </div>

            @if (_response.SelectionReasons.Count > 0)
            {
                <div class="panel-heading">
                    <h2>Selection Reasons</h2>
                    <p>Structured reasons make it easier to see whether the scorer chose the right targets or only got lucky.</p>
                </div>

                <ul class="detail-list">
                    @foreach (var reason in GetSelectionReasonsForDisplay())
                    {
                        <li>
                            <strong>@GetSelectionTargetLabel(reason)</strong>
                            <span>@GetReasonLabel(reason.ReasonKind)</span>
                            @if (reason.RoleKind != FocusedContextReferenceRoleKind.None)
                            {
                                <span>@GetRoleLabel(reason.RoleKind)</span>
                            }
                        </li>
                    }
                </ul>
            }

            @if (_response.ImplementationTypes.Count > 0)
            {
                <div class="panel-heading">
                    <h2>Implementations</h2>
                    <p>These concrete types are treated as definition-adjacent context for helper-like seeds.</p>
                </div>

                <ul class="detail-list">
                    @foreach (var type in _response.ImplementationTypes)
                    {
                        <li><strong>@type.DisplayName</strong> <span>@type.Source.Path:@type.Source.Line</span></li>
                    }
                </ul>
            }

            <div class="type-browser-grid">
                @foreach (var type in _response.Types)
                {
                    <article class="type-browser-card">
                        <div class="type-browser-header">
                            <div>
                                <h3>@type.DisplayName</h3>
                                <p class="field-help">@type.Source.Path:@type.Source.Line</p>
                            </div>
                            <span class="severity-pill severity-info">@type.Kind</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(type.XmlSummary))
                        {
                            <p>@type.XmlSummary</p>
                        }
                    </article>
                }
            </div>

            @if (_response.ReferenceTypes.Count > 0)
            {
                <div class="panel-heading">
                    <h2>Reference Helpers</h2>
                    <p>These are reusable collaborators the graph considered useful even if they did not land in the main excerpt set.</p>
                </div>

                <ul class="detail-list">
                    @foreach (var type in _response.ReferenceTypes)
                    {
                        <li><strong>@type.DisplayName</strong> <span>@type.Source.Path:@type.Source.Line</span></li>
                    }
                </ul>
            }
        </section>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "workspacePath")]
    public string? WorkspacePath { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "projectFilter")]
    public string? ProjectFilter { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "queryText")]
    public string? QueryText { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "tags")]
    public string? Tags { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "relationHints")]
    public string? RelationHints { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "depth")]
    public int? Depth { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "intent")]
    public string? Intent { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "precision")]
    public string? Precision { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "forceRefresh")]
    public bool ForceRefresh { get; set; }

    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    [Inject]
    private CodeAnalyticsWebSettings WebSettings { get; set; } = null!;

    private SnapshotBuildResponse? _buildResponse;
    private FocusedContextResponse? _response;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _errorMessage = null;
        _buildResponse = null;
        _response = null;

        if (string.IsNullOrWhiteSpace(QueryText)) {
            return;
        }

        try {
            var workspacePath = GetWorkspacePath();
            _buildResponse = await ApplicationService.BuildSnapshotAsync(
                new BuildArchitectureSnapshotCommand(
                    workspacePath,
                    ParseDelimitedList(ProjectFilter),
                    ForceRefresh: ForceRefresh));

            _response = await ApplicationService.GetFocusedContextAsync(
                new FocusedContextQuery(
                    _buildResponse.Snapshot.SnapshotId,
                    Depth: GetDepth(),
                    QueryText: QueryText,
                    FocusTags: ParseDelimitedList(Tags),
                    RelationHints: ParseDelimitedList(RelationHints),
                    Intent: GetIntent(),
                    Precision: GetPrecision()));
        }
        catch (Exception exception) {
            _errorMessage = exception.Message;
        }
    }

    private string GetWorkspacePath()
    {
        return string.IsNullOrWhiteSpace(WorkspacePath)
            ? WebSettings.DefaultSolutionPath
            : WorkspacePath;
    }

    private int GetDepth()
    {
        return Math.Clamp(Depth ?? 2, 0, 5);
    }

    private FocusedContextIntent GetIntent()
    {
        return ParseEnumOrDefault(Intent, FocusedContextIntent.Auto);
    }

    private FocusedContextPrecision GetPrecision()
    {
        return ParseEnumOrDefault(Precision, FocusedContextPrecision.Auto);
    }

    private static IReadOnlyList<string> ParseDelimitedList(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) {
            return [];
        }

        return value
            .Split([',', ';', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static TEnum ParseEnumOrDefault<TEnum>(string? value, TEnum fallback)
        where TEnum : struct, Enum
    {
        return Enum.TryParse<TEnum>(value, ignoreCase: true, out var parsed)
            ? parsed
            : fallback;
    }

    private bool IsSeedFile(string path)
    {
        var seedPath = _response?.SeedMember?.Source.Path
            ?? _response?.SeedType?.Source.Path
            ?? _response?.SeedService?.Source.Path;
        return !string.IsNullOrWhiteSpace(seedPath)
            && string.Equals(seedPath, path, StringComparison.OrdinalIgnoreCase);
    }

    private string GetSelectionQuality()
    {
        if (_response is null) {
            return "N/A";
        }

        var broadFileCount = _response.Files.Count(IsBroadFile);
        if (broadFileCount > 0 || _response.Stats.SelectedLineCount > 320 || _response.Stats.FileCount > 5) {
            return "Broad";
        }

        if (_response.Stats.SelectedLineCount > 180 || _response.Stats.FileCount > 3) {
            return "Mixed";
        }

        return "Focused";
    }

    private bool HasBroadSelection()
    {
        return _response is not null && (_response.Files.Any(IsBroadFile) || string.Equals(GetSelectionQuality(), "Broad", StringComparison.Ordinal));
    }

    private string GetSelectedFilesEmptyState()
    {
        if (_response?.ResolvedPrecision == FocusedContextPrecision.Outline) {
            return "Outline precision intentionally suppresses code excerpts. Use the selected symbols, paths, and usage summary to decide whether you need a deeper follow-up pass.";
        }

        return "No file excerpts were selected for the current focused-context run.";
    }

    private static bool IsBroadFile(FocusedContextFileExcerpt file)
    {
        if (file.TotalLineCount <= 0) {
            return false;
        }

        var selectedRatio = (double)file.SelectedLineCount / file.TotalLineCount;
        return file.SelectedLineCount >= 140
            || (file.TotalLineCount >= 120 && selectedRatio >= 0.5);
    }

    private static string GetIntentLabel(FocusedContextIntent intent)
    {
        return intent switch
        {
            FocusedContextIntent.TroublePath => "Trouble path",
            FocusedContextIntent.UsageSummary => "Usage summary",
            FocusedContextIntent.RepresentativeConsumers => "Representative consumers",
            _ => intent.ToString(),
        };
    }

    private static string GetPrecisionLabel(FocusedContextPrecision precision)
    {
        return precision switch
        {
            FocusedContextPrecision.Auto => "Auto",
            FocusedContextPrecision.Balanced => "Balanced",
            FocusedContextPrecision.Surgical => "Surgical",
            FocusedContextPrecision.Outline => "Outline",
            _ => precision.ToString(),
        };
    }

    private IEnumerable<FocusedContextSelectionReason> GetSelectionReasonsForDisplay()
    {
        if (_response is null) {
            return [];
        }

        return _response.SelectionReasons
            .OrderBy(item => item.TargetKind)
            .ThenBy(item => item.TargetId, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.ReasonKind)
            .ThenBy(item => item.RoleKind)
            .ToArray();
    }

    private string GetSelectionTargetLabel(FocusedContextSelectionReason reason)
    {
        if (_response is null) {
            return reason.TargetId;
        }

        if (reason.TargetKind == FocusedContextSelectionTargetKind.File) {
            return reason.TargetId;
        }

        return _response.Members.FirstOrDefault(item => string.Equals(item.MemberId, reason.TargetId, StringComparison.Ordinal))?.DisplayName
            ?? reason.TargetId;
    }

    private string GetReasonSummary(FocusedContextSelectionTargetKind targetKind, string targetId)
    {
        if (_response is null) {
            return string.Empty;
        }

        var comparer = targetKind == FocusedContextSelectionTargetKind.File
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;
        return string.Join(
            ", ",
            _response.SelectionReasons
                .Where(item => item.TargetKind == targetKind && string.Equals(item.TargetId, targetId, comparer))
                .Select(FormatSelectionReason)
                .Distinct(StringComparer.Ordinal));
    }

    private static string FormatSelectionReason(FocusedContextSelectionReason reason)
    {
        return reason.RoleKind == FocusedContextReferenceRoleKind.None
            ? GetReasonLabel(reason.ReasonKind)
            : $"{GetReasonLabel(reason.ReasonKind)} / {GetRoleLabel(reason.RoleKind)}";
    }

    private static string GetReasonLabel(FocusedContextSelectionReasonKind reasonKind)
    {
        return reasonKind switch
        {
            FocusedContextSelectionReasonKind.Seed => "Seed",
            FocusedContextSelectionReasonKind.SeedContext => "Seed context",
            FocusedContextSelectionReasonKind.Implementation => "Implementation",
            FocusedContextSelectionReasonKind.RepresentativeConsumer => "Representative consumer",
            FocusedContextSelectionReasonKind.ServiceRegistration => "Service registration",
            _ => "Related context",
        };
    }

    private static string GetRoleLabel(FocusedContextReferenceRoleKind roleKind)
    {
        return roleKind switch
        {
            FocusedContextReferenceRoleKind.Registration => "Registration",
            FocusedContextReferenceRoleKind.Factory => "Factory",
            FocusedContextReferenceRoleKind.SchemaBootstrap => "Schema bootstrap",
            FocusedContextReferenceRoleKind.ConsumerService => "Consumer service",
            FocusedContextReferenceRoleKind.PreviewLifecycle => "Preview lifecycle",
            _ => "None",
        };
    }
}
