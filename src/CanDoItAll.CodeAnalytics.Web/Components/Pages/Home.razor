@page "/"

<PageTitle>CanDoItAll Code Analytics</PageTitle>

<div class="page-shell">
    <header class="hero">
        <span class="eyebrow">Standalone analysis workspace</span>
        <h1>CanDoItAll Code Analytics</h1>
        <p>
            Roslyn-first architecture snapshots, explicit collectors, deterministic storage,
            and a deliberately thin future seam for <code>CanDoItAll.Mcp.CodeAnalytics</code>.
        </p>
    </header>

    <section class="panel">
        <div class="panel-heading">
            <h2>Run Analysis</h2>
            <p>Pick a solution or a single project, then follow the live operation page while the collectors run.</p>
        </div>

        <form class="analysis-form" method="post" action="/analyze">
            <label class="field">
                <span>Solution or project path</span>
                <div class="path-picker">
                    <input id="workspacePathInput" type="text" name="solutionPath" value="@_defaultSolutionPath" />
                    <button
                        class="secondary-button"
                        type="button"
                        data-workspace-picker
                        data-target-id="workspacePathInput"
                        data-status-id="pickerStatus">
                        Browse
                    </button>
                </div>
                <small class="field-help">
                    Choose a <code>.sln</code>, <code>.slnx</code>, or <code>.csproj</code>. A project file runs scoped project analysis automatically.
                </small>
                <output class="picker-status" id="pickerStatus" aria-live="polite"></output>
            </label>

            <label class="field">
                <span>Project filter</span>
                <input type="text" name="scopeProjectNames" placeholder="Optional comma-separated project names" />
                <small class="field-help">
                    Leave this empty to analyze the full solution, or use it to narrow a solution run to specific projects.
                </small>
            </label>

            <div class="toggle-grid">
                <label><input type="checkbox" name="includeDi" checked /> Include DI</label>
                <label><input type="checkbox" name="includePersistence" checked /> Include persistence</label>
                <label><input type="checkbox" name="includeRisks" checked /> Include risk rules</label>
                <label><input type="checkbox" name="includeXmlDocs" checked /> Include XML docs</label>
                <label><input type="checkbox" name="includeMermaidExports" checked /> Include Mermaid exports</label>
                <label><input type="checkbox" name="forceRefresh" /> Force refresh</label>
            </div>

            <div class="action-row">
                <button class="primary-button" type="submit">Start analysis</button>
                <span class="form-note">The status page refreshes automatically while analysis is running.</span>
            </div>
        </form>
    </section>

    <section class="panel">
        <div class="panel-heading">
            <h2>Recent Snapshots</h2>
            <p>The recent index is file-based and deterministic.</p>
        </div>

        @if (_recentSnapshots.Count == 0)
        {
            <p class="empty-state">No snapshots have been stored yet.</p>
        }
        else
        {
            <div class="recent-list">
                @foreach (var item in _recentSnapshots)
                {
                    <a class="recent-card" href="@($"/snapshots/{item.SnapshotId}")">
                        <strong>@item.SolutionName</strong>
                        <span>@item.CreatedUtc.ToString("u")</span>
                        <span>@item.FindingCount findings / @item.DiagnosticCount diagnostics</span>
                    </a>
                }
            </div>
        }
    </section>
</div>

@code {
    [Inject]
    private ICodeAnalyticsApplicationService ApplicationService { get; set; } = null!;

    [Inject]
    private CodeAnalyticsWebSettings WebSettings { get; set; } = null!;

    private string _defaultSolutionPath = string.Empty;
    private IReadOnlyList<RecentSnapshotItem> _recentSnapshots = [];

    protected override async Task OnInitializedAsync()
    {
        _defaultSolutionPath = WebSettings.DefaultSolutionPath;
        _recentSnapshots = await ApplicationService.ListRecentSnapshotsAsync(10);
    }
}
