<article class="stat-card">
    <span class="stat-label">@Label</span>
    <strong class="stat-value">@Value</strong>
</article>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;
}
