@inject NavigationManager Navigation

<SecondaryTabs Items="@Items"
               SelectedKey="@SelectedKey"
               SelectedKeyChanged="NavigateAsync"
               Dense="true"
               ShowActiveDescription="false" />

@code {
    [Parameter, EditorRequired]
    public string SnapshotId { get; set; } = string.Empty;

    [Parameter]
    public string ActiveTab { get; set; } = string.Empty;

    private static readonly IReadOnlyList<SecondaryTabItem> Items =
    [
        new("dashboard", "Dashboard"),
        new("dependencies", "Dependencies"),
        new("services", "Services"),
        new("persistence", "Persistence"),
        new("types", "Types"),
        new("symbols", "Symbols"),
        new("findings", "Findings"),
        new("exports", "Exports")
    ];

    private string BasePath => $"/snapshots/{SnapshotId}";

    private string SelectedKey => string.IsNullOrWhiteSpace(ActiveTab)
        ? "dashboard"
        : ActiveTab;

    private Task NavigateAsync(string key)
    {
        var route = string.Equals(key, "dashboard", StringComparison.Ordinal)
            ? BasePath
            : $"{BasePath}/{key}";
        Navigation.NavigateTo(route);
        return Task.CompletedTask;
    }
}
